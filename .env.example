# Runtime: auto | aws | local
RUNTIME_MODE=local

# Auth
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
# Local SQLite (default when RUNTIME_MODE=local)
# Prefer absolute or project-relative; shared config resolves relative sqlite paths to repo root.
DATABASE_URL=sqlite+aiosqlite:///data/commerce.db
# AWS / Postgres example:
# DATABASE_URL=postgresql+asyncpg://commerce:commerce@localhost:5432/commerceai

# Neo4j (AWS mode; ignored in local SQL-graph mode)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=commerceai

# AWS / LocalStack
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL=
S3_BUCKET=commerceai-documents
SQS_QUEUE_URL=
SQS_DLQ_URL=

# Local storage
LOCAL_STORAGE_PATH=./storage/uploads

# OpenAI (optional — mock provider used when unset)
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o

# Services
CORE_API_URL=http://localhost:8100
AI_PIPELINE_URL=http://localhost:8001
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8100
